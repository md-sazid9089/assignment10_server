# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/artify?retryWrites=true&w=majority

# Firebase Admin SDK Configuration (Option 1: Service Account JSON)
# Place your service account JSON file as firebase-service-account.json in the project root
# OR use the environment variables below (Option 2)

# Firebase Admin SDK Configuration (Option 2: Environment Variables)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration (Add your frontend URLs)
CLIENT_URL=http://localhost:3000

# For Production on Vercel:
# Set these environment variables in Vercel Dashboard:
# - MONGODB_URI
# - FIREBASE_PROJECT_ID
# - FIREBASE_PRIVATE_KEY
# - FIREBASE_CLIENT_EMAIL
# - CLIENT_URL (your Netlify URL)
